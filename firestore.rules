rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 글(posts): 누구나 읽기 가능, 쓰기는 로그인한 관리자만 (관리자 페이지에서 사용)
    match /posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 여행기(travel_posts): 누구나 읽기 가능, 쓰기는 로그인한 관리자만
    match /travel_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 그 외 전체: 읽기 허용, 쓰기 잠금
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
